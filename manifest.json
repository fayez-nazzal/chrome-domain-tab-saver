{
  "manifest_version": 3,
  "name": "Domain Tab Saver",
  "version": "1.0.0",
  "description": "Keeps one tab per configured domain by reusing the tab that is already open.",
  "permissions": ["tabs", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Domain Tab Saver"
  }
}
